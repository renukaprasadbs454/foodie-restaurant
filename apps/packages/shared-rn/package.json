    "expo-secure-store": ">=13.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.73.0",
    "react-redux": "^9.0.0",
    "sockjs-client": "^1.6.0"
  },
  "peerDependenciesMeta": {
    "@react-native-community/netinfo": {
      "optional": false
    },
    "expo-secure-store": {
      "optional": false
    },
    "@stomp/stompjs": {
      "optional": false
    },
    "sockjs-client": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
