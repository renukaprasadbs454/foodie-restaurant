  "description": "Shared React Native foundation package for Foodie Customer, Restaurant, and Delivery apps",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "react-native": "src/index.ts",
  "files": [
    "dist",
    "src"
  ],
